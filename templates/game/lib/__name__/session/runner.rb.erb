module <%= module_name %>
  module Session
    class Runner < PlaiTestr::Session::Runner
      include Bot

      RULES_PATH = File.expand_path('../../../data/rules.md', __dir__)

      DEBRIEF_QUESTIONS = [
        'Which decision in this game mattered most, and why?',
        'Which rule was unclear or confusing?',
        'Which choices felt automatic (the choice did not matter)?'
      ].freeze

      def setup
        raise NotImplementedError, "#{self.class}#setup: build the starting state; PlaiTestr::Deck.build(@rules).shuffle(random: @rng) gives a shuffled deck"
      end

      def legal_moves(_player)
        raise NotImplementedError, "#{self.class}#legal_moves: return [option('Play 3♣', public: 'played 3♣', play: { value: uid }), ...]"
      end

      def apply_action_effects(_player, _action)
        raise NotImplementedError, "#{self.class}#apply_action_effects: case action in { play: { value: uid } } then ...; apply it to @game_state; set status 'game_over', 'winner' and 'end_reason' when the game ends"
      end

      def rules_text_for(_player) = @rules_text ||= File.read(RULES_PATH)

      def debrief_questions(_player) = DEBRIEF_QUESTIONS

      private

      def players        = @game_state.players
      def pstate(player) = @game_state.player_state(player)
    end
  end
end
