#!/usr/bin/env ruby

$LOAD_PATH.unshift File.expand_path('../lib', __dir__)
require 'plai_tester'

MODELS = {
  player:  ENV.fetch('PLAITESTER_PLAYER_MODEL',  'llama3.2:3b'),
  referee: ENV.fetch('PLAITESTER_REFEREE_MODEL', 'qwen3:8b')
}.freeze

OLLAMA_HOST = ENV.fetch('PLAITESTER_OLLAMA_HOST', 'localhost')
OLLAMA_PORT = ENV.fetch('PLAITESTER_OLLAMA_PORT', '11434').to_i

command = ARGV[0]

case command

when 'start'
  rules_file = ARGV[1] or abort "Usage: plai_tester start <rules_file>"

  rules   = PlaiTester::Compiler::RulesLoader.load(rules_file)
  count   = rules.dig('game', 'player_count', 'default') || 2
  players = Array.new(count) { |i| "Player #{i + 1}" }

  PlaiTester::Session::Runner.new(
    rules:       rules,
    players:     players,
    models:      MODELS,
    ollama_host: OLLAMA_HOST,
    ollama_port: OLLAMA_PORT
  ).run

when 'resume'
  session_id = ARGV[1] or abort "Usage: plai_tester resume <session_id>"

  PlaiTester::Session::Runner.resume(
    session_id:  session_id,
    models:      MODELS,
    ollama_host: OLLAMA_HOST,
    ollama_port: OLLAMA_PORT
  ).run

when 'list'
  sessions = PlaiTester::Session::Manager.list

  if sessions.empty?
    puts "No sessions found."
  else
    puts "%-20s  %-28s  %-12s  %s" % %w[SESSION_ID GAME STATUS SAVED_AT]
    puts "-" * 80
    sessions.each { |s| puts "%-20s  %-28s  %-12s  %s" % s.values_at('session_id', 'game', 'status', 'saved_at') }
  end

when 'report'
  session_id = ARGV[1] or abort "Usage: plai_tester report <session_id>"

  manager    = PlaiTester::Session::Manager.new(session_id: session_id)
  checkpoint = manager.load_checkpoint
  rules      = JSON.parse(File.read(checkpoint['rules_file']))
  game_state = PlaiTester::State::GameState.from_h(checkpoint['game_state'])

  path = PlaiTester::Reporter::ReportBuilder.new(
    session_id: session_id,
    rules:      rules,
    game_state: game_state,
    turn_log:   checkpoint['turn_log']
  ).build

  puts "Report written to #{path}"

else
  puts <<~USAGE
    PlaiTester — Automated Board Game Playtesting

    Usage:
      plai_tester start <rules_file>     Start a new session
      plai_tester resume <session_id>    Resume an interrupted session
      plai_tester list                   List all sessions
      plai_tester report <session_id>    Generate a report from a saved session

    Environment variables:
      PLAITESTER_PLAYER_MODEL   Ollama model for player agents  (default: llama3.2:3b)
      PLAITESTER_REFEREE_MODEL  Ollama model for referee agent  (default: qwen3:8b)
      PLAITESTER_OLLAMA_HOST    Ollama host                     (default: localhost)
      PLAITESTER_OLLAMA_PORT    Ollama port                     (default: 11434)
  USAGE
end
